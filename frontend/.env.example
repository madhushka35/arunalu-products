# Arunalu Products – frontend environment (copy to .env.local; never commit real values)

# Laravel API base URL, server-side only (report §11).
# Local:      http://localhost:8000/api/v1
# Production: https://api.arunaluproducts.lk/api/v1
API_BASE_URL=

# Inquiry forms preview mode. With no API_BASE_URL, development shows a preview
# (nothing is stored or sent). Never set to "true" in production.
INQUIRY_PREVIEW_MODE=false
